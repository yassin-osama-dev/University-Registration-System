<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="440.0" prefWidth="720.0" style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AppController">
    <center>
        <HBox alignment="CENTER" spacing="0.0">
            <padding>
                <Insets bottom="38.0" left="46.0" right="46.0" top="38.0" />
            </padding>

            <VBox alignment="CENTER_LEFT" prefWidth="310.0" spacing="14.0" style="-fx-background-color: #1f2937; -fx-background-radius: 10 0 0 10;">
                <padding>
                    <Insets bottom="34.0" left="32.0" right="32.0" top="34.0" />
                </padding>
                <Label text="University Registration" textFill="white" wrapText="true">
                    <font>
                        <Font size="30.0" />
                    </font>
                </Label>
                <Text fill="#cbd5e1" strokeType="OUTSIDE" strokeWidth="0.0" text="Manage students, professors, courses, and academic registration from one place." wrappingWidth="245.0">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Text>
                <Region VBox.vgrow="ALWAYS" />
                <Label style="-fx-background-color: #334155; -fx-background-radius: 6; -fx-padding: 8 12 8 12;" text="Academic Portal" textFill="#e5e7eb" />
            </VBox>

            <VBox alignment="CENTER_LEFT" prefWidth="320.0" spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 0 10 10 0; -fx-border-color: #d7dce2; -fx-border-width: 1 1 1 0; -fx-border-radius: 0 10 10 0;">
                <padding>
                    <Insets bottom="34.0" left="34.0" right="34.0" top="34.0" />
                </padding>
                <Label text="Choose Portal" textFill="#111827">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>
                <Text fill="#6b7280" strokeType="OUTSIDE" strokeWidth="0.0" text="Select where you want to continue." wrappingWidth="250.0">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Text>
                <VBox spacing="12.0">
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openProfessorView" prefHeight="46.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-size: 14px; -fx-font-weight: bold;" text="Professor" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openStudentView" prefHeight="46.0" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-size: 14px; -fx-font-weight: bold;" text="Student" />
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
