<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f5f7fb;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AddNewStudentController">
   <children>
      <Text layoutX="184.0" layoutY="58.0" strokeType="OUTSIDE" strokeWidth="0.0" text="New Student">
         <font>
            <Font size="34.0" />
         </font>
      </Text>
      <Label layoutX="150.0" layoutY="93.0" text="Name" />
      <TextField fx:id="nameField" layoutX="245.0" layoutY="88.0" prefHeight="28.0" prefWidth="205.0" promptText="Student name" />
      <Label layoutX="150.0" layoutY="139.0" text="ID" />
      <TextField fx:id="idField" layoutX="245.0" layoutY="134.0" prefHeight="28.0" prefWidth="205.0" promptText="Student ID" />
      <Label layoutX="150.0" layoutY="185.0" text="Email" />
      <TextField fx:id="emailField" layoutX="245.0" layoutY="180.0" prefHeight="28.0" prefWidth="205.0" promptText="student@example.com" />
      <Label layoutX="150.0" layoutY="231.0" text="Major" />
      <TextField fx:id="majorField" layoutX="245.0" layoutY="226.0" prefHeight="28.0" prefWidth="205.0" promptText="Major" />
      <Label layoutX="150.0" layoutY="277.0" text="GPA" />
      <TextField fx:id="gpaField" layoutX="245.0" layoutY="272.0" prefHeight="28.0" prefWidth="205.0" promptText="0.0 - 4.0" />
      <Button layoutX="37.0" layoutY="348.0" mnemonicParsing="false" onAction="#backToStudentMenu" prefWidth="78.0" text="Back" />
      <Button layoutX="245.0" layoutY="330.0" mnemonicParsing="false" onAction="#addStudent" prefHeight="32.0" prefWidth="116.0" text="Add Student" />
   </children>
</AnchorPane>
