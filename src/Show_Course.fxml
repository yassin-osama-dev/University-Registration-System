<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="470.0" prefWidth="780.0" style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AppController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #d7dce2; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="14.0" left="26.0" right="26.0" top="14.0" />
            </padding>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Available Courses" textFill="#111827">
                    <font>
                        <Font size="23.0" />
                    </font>
                </Label>
                <Text fill="#6b7280" strokeType="OUTSIDE" strokeWidth="0.0" text="Course catalog, registered counts, and seat availability" />
            </VBox>
            <Button mnemonicParsing="false" onAction="#backToStudentMenu" prefWidth="88.0" style="-fx-background-color: #f3f4f6; -fx-border-color: #cbd5e1; -fx-border-radius: 7; -fx-background-radius: 7; -fx-text-fill: #1f2937;" text="Back" />
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="24.0" left="26.0" right="26.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #1f2937; -fx-background-radius: 9;">
                <padding>
                    <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
                </padding>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Course Inventory" textFill="white">
                        <font>
                            <Font size="20.0" />
                        </font>
                    </Label>
                    <Text fill="#cbd5e1" strokeType="OUTSIDE" strokeWidth="0.0" text="Scan current offerings and capacity at a glance" />
                </VBox>
                <Label style="-fx-background-color: #334155; -fx-background-radius: 6; -fx-padding: 7 12 7 12;" text="Live Data" textFill="#e5e7eb" />
            </HBox>

            <TableView fx:id="coursesTable" prefHeight="310.0" prefWidth="720.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d7dce2; -fx-border-radius: 8;">
                <padding>
                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                </padding>
                <columns>
                    <TableColumn fx:id="codeColumn" prefWidth="110.0" text="Code" />
                    <TableColumn fx:id="titleColumn" prefWidth="285.0" text="Title" />
                    <TableColumn fx:id="creditsColumn" prefWidth="80.0" text="Credits" />
                    <TableColumn fx:id="registeredColumn" prefWidth="105.0" text="Registered" />
                    <TableColumn fx:id="seatsColumn" prefWidth="110.0" text="Seats Left" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
