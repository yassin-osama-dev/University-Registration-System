<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="470.0" prefWidth="760.0" style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AppController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #d7dce2; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="14.0" left="26.0" right="26.0" top="14.0" />
            </padding>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Course Registration" textFill="#111827">
                    <font>
                        <Font size="23.0" />
                    </font>
                </Label>
                <Text fill="#6b7280" strokeType="OUTSIDE" strokeWidth="0.0" text="Enroll an existing student into an available course" />
            </VBox>
            <Button mnemonicParsing="false" onAction="#backToStudentMenu" prefWidth="88.0" style="-fx-background-color: #f3f4f6; -fx-border-color: #cbd5e1; -fx-border-radius: 7; -fx-background-radius: 7; -fx-text-fill: #1f2937;" text="Back" />
        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="0.0">
            <padding>
                <Insets bottom="38.0" left="54.0" right="54.0" top="38.0" />
            </padding>

            <VBox alignment="CENTER_LEFT" prefWidth="260.0" spacing="12.0" style="-fx-background-color: #2563eb; -fx-background-radius: 10 0 0 10;">
                <padding>
                    <Insets bottom="30.0" left="28.0" right="28.0" top="30.0" />
                </padding>
                <Label text="Enrollment" textFill="white">
                    <font>
                        <Font size="28.0" />
                    </font>
                </Label>
                <Text fill="#dbeafe" strokeType="OUTSIDE" strokeWidth="0.0" text="Use the student ID and course code exactly as they appear in the records." wrappingWidth="205.0">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Text>
            </VBox>

            <GridPane hgap="14.0" prefWidth="360.0" vgap="16.0" style="-fx-background-color: white; -fx-background-radius: 0 10 10 0; -fx-border-color: #d7dce2; -fx-border-width: 1 1 1 0; -fx-border-radius: 0 10 10 0;">
                <padding>
                    <Insets bottom="34.0" left="32.0" right="32.0" top="34.0" />
                </padding>
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="96.0" prefWidth="110.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="190.0" prefWidth="230.0" />
                </columnConstraints>

                <Label text="Student ID" textFill="#374151" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="studentIdField" promptText="Student ID" style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #cbd5e1;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Course Code" textFill="#374151" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="courseCodeField" promptText="Course code" style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #cbd5e1;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#enrollStudentInCourse" prefHeight="38.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-size: 14px; -fx-font-weight: bold;" text="Enroll Student" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>
        </HBox>
    </center>
</BorderPane>
