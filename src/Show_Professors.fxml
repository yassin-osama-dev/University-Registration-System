<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="470.0" prefWidth="920.0" style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AppController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #d7dce2; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="14.0" left="26.0" right="26.0" top="14.0" />
            </padding>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Professors" textFill="#111827">
                    <font>
                        <Font size="23.0" />
                    </font>
                </Label>
                <Text fill="#6b7280" strokeType="OUTSIDE" strokeWidth="0.0" text="Faculty directory and assigned teaching load" />
            </VBox>
            <Button mnemonicParsing="false" onAction="#openAddProfessor" prefWidth="130.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-weight: bold;" text="Add Professor" />
            <Button mnemonicParsing="false" onAction="#openAssignProfessorCourses" prefWidth="140.0" style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-weight: bold;" text="Assign Course" />
            <Button mnemonicParsing="false" onAction="#openDropStudent" prefWidth="125.0" style="-fx-background-color: #b91c1c; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-weight: bold;" text="Drop Student" />
            <Button mnemonicParsing="false" onAction="#backToLogin" prefWidth="88.0" style="-fx-background-color: #f3f4f6; -fx-border-color: #cbd5e1; -fx-border-radius: 7; -fx-background-radius: 7; -fx-text-fill: #1f2937;" text="Back" />
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding>
                <Insets bottom="24.0" left="26.0" right="26.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #1f2937; -fx-background-radius: 9;">
                <padding>
                    <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
                </padding>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label text="Faculty Records" textFill="white">
                        <font>
                            <Font size="20.0" />
                        </font>
                    </Label>
                    <Text fill="#cbd5e1" strokeType="OUTSIDE" strokeWidth="0.0" text="Double-click a row to open the professor profile" />
                </VBox>
                <Label style="-fx-background-color: #334155; -fx-background-radius: 6; -fx-padding: 7 12 7 12;" text="Profiles" textFill="#e5e7eb" />
            </HBox>

            <TableView fx:id="professorsTable" prefHeight="310.0" prefWidth="860.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #d7dce2; -fx-border-radius: 8;">
                <padding>
                    <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                </padding>
                <columns>
                    <TableColumn fx:id="professorIdColumn" prefWidth="100.0" text="ID" />
                    <TableColumn fx:id="professorNameColumn" prefWidth="160.0" text="Name" />
                    <TableColumn fx:id="professorEmailColumn" prefWidth="220.0" text="Email" />
                    <TableColumn fx:id="professorDepartmentColumn" prefWidth="150.0" text="Department" />
                    <TableColumn fx:id="professorCoursesColumn" prefWidth="250.0" text="Assigned Courses" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
