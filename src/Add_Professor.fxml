<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="520.0" prefWidth="820.0" style="-fx-background-color: #eef2f7;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AppController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-border-color: #d7dce2; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="14.0" left="26.0" right="26.0" top="14.0" />
            </padding>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="New Professor" textFill="#111827">
                    <font>
                        <Font size="23.0" />
                    </font>
                </Label>
                <Text fill="#6b7280" strokeType="OUTSIDE" strokeWidth="0.0" text="Create a professor profile and save it to the registration system" />
            </VBox>
            <Button mnemonicParsing="false" onAction="#backToProfessorMenu" prefWidth="88.0" style="-fx-background-color: #f3f4f6; -fx-border-color: #cbd5e1; -fx-border-radius: 7; -fx-background-radius: 7; -fx-text-fill: #1f2937;" text="Back" />
        </HBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="0.0">
            <padding>
                <Insets bottom="34.0" left="46.0" right="46.0" top="34.0" />
            </padding>

            <VBox alignment="CENTER_LEFT" prefWidth="270.0" spacing="12.0" style="-fx-background-color: #1f2937; -fx-background-radius: 10 0 0 10;">
                <padding>
                    <Insets bottom="30.0" left="28.0" right="28.0" top="30.0" />
                </padding>
                <Label text="Faculty Record" textFill="white" wrapText="true">
                    <font>
                        <Font size="27.0" />
                    </font>
                </Label>
                <Text fill="#cbd5e1" strokeType="OUTSIDE" strokeWidth="0.0" text="Add the professor once, then assign courses from the professor dashboard." wrappingWidth="210.0">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Text>
                <Region VBox.vgrow="ALWAYS" />
                <Label style="-fx-background-color: #334155; -fx-background-radius: 6; -fx-padding: 8 12 8 12;" text="Professor Directory" textFill="#e5e7eb" />
            </VBox>

            <GridPane hgap="14.0" prefWidth="430.0" vgap="14.0" style="-fx-background-color: white; -fx-background-radius: 0 10 10 0; -fx-border-color: #d7dce2; -fx-border-width: 1 1 1 0; -fx-border-radius: 0 10 10 0;">
                <padding>
                    <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                </padding>
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="92.0" prefWidth="104.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="230.0" prefWidth="270.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="42.0" />
                    <RowConstraints minHeight="42.0" />
                    <RowConstraints minHeight="42.0" />
                    <RowConstraints minHeight="42.0" />
                    <RowConstraints minHeight="48.0" />
                </rowConstraints>

                <Label text="Name" textFill="#374151" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="nameField" promptText="Professor name" style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #cbd5e1;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="ID" textFill="#374151" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="idField" promptText="Professor ID" style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #cbd5e1;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Email" textFill="#374151" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="emailField" promptText="professor@university.com" style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #cbd5e1;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Department" textFill="#374151" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextField fx:id="departmentField" promptText="Computer Science" style="-fx-background-radius: 7; -fx-border-radius: 7; -fx-border-color: #cbd5e1;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#addProfessor" prefHeight="38.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-size: 14px; -fx-font-weight: bold;" text="Add Professor" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </GridPane>
        </HBox>
    </center>
</BorderPane>
